# Database Credentials (override docker-compose defaults here for local dev)
# [CHANGE IN PRODUCTION] If running the backend natively via 'make dev-local' and connecting to a live database, update these values.
user=postgres
password=password
host=localhost
port=5432
dbname=postgres

# Message Broker
broker_url=amqp://guest:guest@localhost:5672/

# CORS Details
ORIGIN_URL=http://localhost:3000

# S3 / SeaweedFS details (defaults to local docker SeaweedFS)
USE_S3=true
S3_ENDPOINT=http://localhost:8333
S3_KEY=any
S3_SECRET=any
S3_BUCKET=thi-data