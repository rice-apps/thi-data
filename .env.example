# Repo root: copy to `.env` — used by docker compose; `make dev` sources it for NEXT_DEV_PROXY_API_ORIGIN.

PUBLIC_PORT=80
API_SUBPATH=/api

API_PORT=8000
API_PUBLISH_PORT=8000
API_PUBLISH_HOST=127.0.0.1

DB_USER=postgres
DB_PASSWORD=password
DB_NAME=postgres
DB_PORT=5432

# Better Auth (Next.js)
# Generate a strong secret (32+ chars) for production.
BETTER_AUTH_SECRET=
# External URL users visit (nginx/public). Include API_SUBPATH if you proxy auth under /api/auth.
BETTER_AUTH_URL=http://localhost:80/api
# Browser-side base URL for Better Auth client. Can be /api if same-origin.
NEXT_PUBLIC_BETTER_AUTH_URL=/api

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

STORAGE_KEY=any
STORAGE_SECRET=any
STORAGE_S3_PORT=8333
STORAGE_MASTER_PORT=9333
STORAGE_FILER_PORT=8888
