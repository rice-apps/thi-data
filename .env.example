# Repo root: copy to `.env` — used by docker compose; `make dev` sources it for NEXT_DEV_PROXY_API_ORIGIN.

PUBLIC_PORT=80
API_SUBPATH=/api

API_PORT=8000
API_PUBLISH_PORT=8000
API_PUBLISH_HOST=127.0.0.1

DB_USER=postgres
DB_PASSWORD=password
DB_NAME=postgres
DB_PORT=5432

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

STORAGE_KEY=any
STORAGE_SECRET=any
STORAGE_S3_PORT=8333
STORAGE_MASTER_PORT=9333
STORAGE_FILER_PORT=8888
